{
  "name": "vector-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spectral Homestead — a graph-NCA 3D vector environment simulator",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:node": "esbuild scripts/benchmark-node.ts --bundle --platform=node --format=esm --outfile=.tmp/benchmark-node.mjs && node .tmp/benchmark-node.mjs",
    "capture:spectral": "esbuild scripts/generate-spectral-reference.ts --bundle --platform=node --format=esm --external:sharp --outfile=.tmp/generate-spectral-reference.mjs && node .tmp/generate-spectral-reference.mjs",
    "validate:p01": "node scripts/validate-p01.mjs",
    "validate:p02": "node scripts/validate-p02.mjs",
    "validate:p03": "node scripts/validate-p03.mjs",
    "qa": "npm run validate:p01 && npm run validate:p02 && npm run validate:p03 && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
